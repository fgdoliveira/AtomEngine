# The flashlight (M44): the dark corridor turns you back until you have
# it; it lies on the entry step; in its beam, chalk on the corridor wall
# appears - and can be looked at - and with it off, both are gone. Taken,
# it stays taken.
goto_level machiya_interior
wait_for_level machiya_interior
teleport_to dark_corridor 1.4
face dark_corridor
interact dark_corridor
expect_message too dark
expect_lit chalk_marks no

teleport_to flashlight 1.3
face flashlight
expect_target flashlight
interact flashlight
expect_flag has_flashlight

teleport 3.3 0.3 -10.9 -36           # in the corridor mouth, the chalk to the left
face chalk_marks
wait 0.8                             # the beam swings round after the view
expect_lit chalk_marks
expect_target chalk_marks
press_action toggle_light
wait 0.3
expect_lit chalk_marks no
expect_target none
press_action toggle_light
wait 0.3

teleport_to dark_corridor 1.4
face dark_corridor
interact dark_corridor
expect_message stairs
teleport_to flashlight 1.3
face flashlight
expect_target none                   # taken
