# The character lab's drive mode (M38): Tab hands Rudy to the keys; the
# animator follows what his body does - walk, run, jump, stand - and he
# climbs the steps and the ramp on the player's kind of body.
goto_level character_lab
wait_for_level character_lab
wait_for_mode viewer 5
press_action toggle_drive
wait 0.1
expect_mode drive
expect_state rudy idle
teleport 0 0.05 0 180                # facing +Z: open floor (behind him is the backdrop)
wait 0.2

# Walk, then run (the walk/run blend leans to the run), then stop.
hold_action move_forward on
wait 1.5
expect_state rudy move
expect_clip rudy Walk
hold_action jog on
wait 1.2
expect_clip rudy Run
hold_action jog off
hold_action move_forward off
wait 1.2
expect_state rudy idle

# A jump: in the air, then back on the ground and standing.
press_action jump
wait 0.15
expect_state rudy jump
wait 1.6
expect_state rudy idle

# Up the two steps onto the platform (0.45 m), walking along +X.
teleport 2.5 0 2 90
wait 0.1
hold_action move_forward on
wait 2.0
hold_action move_forward off
wait 0.5
expect_near 5.7 0.45 2 0.4

# Up the ramp onto the higher platform (0.6 m), walking along -X.
teleport -2.5 0 2 -90
wait 0.1
hold_action move_forward on
wait 3.0
hold_action move_forward off
wait 0.5
expect_near -7.3 0.6 2 0.4

# Tab back: the viewer again, orbiting Rudy where he stands.
press_action toggle_drive
wait 0.1
expect_mode viewer
