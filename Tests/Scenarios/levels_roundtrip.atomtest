# Street -> shrine grounds -> street -> machiya interior -> street ->
# windmill field -> street -> (bus) night city -> (bus) street.
# Checks that the gate is locked until the keeper allows it, that flags
# survive level changes, and that no ambience voices leak across them.
# Voice budget: level voices + 1 persistent static voice.

expect_level street
expect_voices_max 7                  # 3 beds + 3 vending hums + static

# The gate is barred until the keeper lets you in.
teleport_to shrine_gate
interact shrine_gate
expect_message barred from the inside
expect_level street

teleport_to torii
interact torii
teleport_to shrine_keeper
interact shrine_keeper
choose 2                             # the gate
choose 1                             # "I only want to pay my respects."
finish_dialogue
expect_flag keeper_permission

teleport_to shrine_gate
interact shrine_gate
expect_mode transitioning
wait_for_level shrine_grounds
expect_flag keeper_permission        # progress survived the level change
expect_voices_max 4                  # 3 beds + static: the street's voices stopped

teleport_to stone_lantern
interact stone_lantern
expect_message paper is warm
teleport_to offering_box
interact offering_box
expect_flag prayed_at_hall

teleport_to gate_back
interact gate_back
wait_for_level street
expect_flag prayed_at_hall
expect_voices_max 7

teleport_to house_door
interact house_door
wait_for_level machiya_interior
expect_voices_max 3                  # room tone + drone + static

# Footsteps: earth in the doma, floorboards and tatami past the step.
teleport 0 0 -1.5 0
expect_surface dirt
teleport 0 0.3 -5 0
expect_surface wood

teleport_to letter
interact letter
expect_flag read_letter
teleport_to fusuma
interact fusuma
expect_message won't slide
teleport_to scroll
interact scroll
# Step into the corridor (M44: you can, as far as the stairs): from
# beside the opening the wall blocks the view, for a player as much as
# for the targeting check.
teleport 3.1 0.3 -11.8 0
face dark_corridor
interact dark_corridor
expect_message too dark

teleport_to door_back
interact door_back
wait_for_level street
expect_voices_max 7
expect_flag read_letter

# The windmill field (level D), past the west end of the street.
teleport_to field_path
interact field_path
wait_for_level windmill_field
expect_voices_max 4                  # 3 beds + static (one-shot creaks don't count)
expect_animating windmill
expect_animating hanging_sign
teleport 0 0 16 0
expect_surface stone                 # the gravel track
teleport_to shed
interact shed
expect_message darkness inside
wait_for_animation shed 5
interact shed                        # opened once, it stays open
wait_for_animation shed 1
teleport_to path_back
interact path_back
wait_for_level street
expect_voices_max 7

# The night bus (M26): wait at the stop, the bus arrives, fade to the city;
# the player is frozen meanwhile, and the ride back mirrors it.
teleport_to bus_stop 2
face bus_stop
interact bus_stop
expect_mode sequence
wait 0.5
expect_target none                   # frozen: nothing can be used, nothing starts twice
expect_mode sequence
wait_for_sequence 20
wait_for_level night_street 10
expect_near -26 0.12 3.6 1
expect_flag rode_bus_to_city
expect_flag read_letter              # progress rode along
teleport_to timetable 1.6
face timetable
interact timetable
expect_mode sequence
wait_for_sequence 20
wait_for_level street 10
expect_flag rode_bus_home
expect_near 38 0 -3 1
expect_voices_max 7                  # the bus's engine stopped with the city
log roundtrip done
