# The night street (M25) and the pachinko hall (M27): level E loads with its per-cell lightmaps; the
# cell ambience crossfades as the player walks from the bus stop into the
# pachinko plaza; the interactables tie back to the rural street.
expect_level street
goto_level night_street from_bus
wait_for_level night_street
expect_mode exploring
wait 2.5
expect_zone bus_stop
expect_surface concrete
teleport 0 0 0 90                    # main street, on the road
wait 2.5
expect_zone main_street
expect_surface asphalt
teleport_to notice_board 1.2
face notice_board
interact notice_board
expect_flag read_city_notice
teleport_to phone_box 1.6
face phone_box
interact phone_box
expect_message dial tone             # the letter from the house wasn't read
teleport 6 0.12 -12 0                # in the alley
wait 2.5
expect_zone alley
teleport 16.75 0.12 -24 0            # the pachinko front
wait 2.5
expect_zone pachinko_front
teleport_to pachinko_doors 2
face pachinko_doors
expect_voices_max 22
interact pachinko_doors
wait_for_level pachinko_hall

# The pachinko hall (M27): the machine screens show live render textures,
# the attract loops running; out again through the doors.
expect_voices_max 4                  # hall bed + drone + static (+1 slack)
wait 0.5
expect_screens 2                     # both screen materials sample a live texture
teleport_to machine 1.2
face machine
interact machine
expect_message keeps playing
teleport_to exit_doors 1.8
face exit_doors
interact exit_doors
wait_for_level night_street
expect_near 16.75 0.12 -27 1
goto_level street
wait_for_level street
expect_voices_max 7
log night street done
