  "sequences": {
    "bus_to_street": [
      { "type": "message", "text": "Last bus back to the rural line: 23:52. You wait under the railway." },
      { "type": "wait", "seconds": 3 },
      { "type": "show", "entity": "bus" },
      { "type": "playSound", "sound": "bus_engine", "entity": "bus", "gain": 0.8, "loop": true },
      { "type": "moveEntity", "entity": "bus", "to": [-28.6, 0.0, 1.7], "seconds": 8 },
      { "type": "playAnimation", "entity": "bus", "clip": "doors_open" },
      { "type": "playSound", "sound": "door_hiss", "entity": "bus", "gain": 0.9 },
      { "type": "message", "text": "The same bus, the same driver. The doors fold open with a sigh." },
      { "type": "wait", "seconds": 2.5 },
      { "type": "message", "text": "You ride back through the dark. The city lights thin out, then stop." },
      { "type": "setFlag", "flag": "rode_bus_home" },
      { "type": "wait", "seconds": 1 },
      { "type": "changeLevel", "level": "street", "spawn": "from_bus" }
    ]
  },
