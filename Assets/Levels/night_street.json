    {
      "name": "phone_box",
      "interactable": {
        "prompt": "Use the phone", "focus": [0.0, 1.3, 0.45], "radius": 2.4,
        "requires": "read_letter",
        "action": { "type": "setFlag", "flag": "called_the_house", "message": "You dial the number from the letter. It rings once. Someone picks up, breathes, and says nothing." },
        "locked": { "type": "message", "text": "A dial tone. You don't know anyone's number in this city." }
      }
    },
    {
      "name": "notice_board",
      "interactable": {
        "prompt": "Read the notices", "focus": [0.0, 1.6, 0.1],
        "action": { "type": "setFlag", "flag": "read_city_notice", "message": "MISSING. The photo shows a rural street you know: the torii, three vending machines. 'Last seen waiting for the night bus.'" }
      }
    },
    {
      "name": "ramen_shop",
      "interactable": {
        "prompt": "Look inside", "focus": [0.0, 1.6, 0.2],
        "action": { "type": "message", "text": "Steam on the glass. A chef wipes the counter, over and over, in front of empty stools." }
      }
    },
    {
      "name": "shutter",
      "interactable": {
        "prompt": "Knock on the shutter", "focus": [0.0, 1.5, 0.1],
        "action": { "type": "message", "text": "Behind the shutter, a radio plays the same song from the beginning, again and again." }
      }
    },
    {
      "name": "bicycles",
      "interactable": {
        "prompt": "Look at the bicycles", "focus": [0.0, 0.8, 0.0],
        "action": { "type": "message", "text": "All three are locked to each other. One still has a shrine charm on the handlebar." }
      }
    },
    {
      "name": "alley_shrine",
      "interactable": {
        "prompt": "Look at the shrine", "focus": [0.3, 1.0, 0.0], "radius": 2.0,
        "requires": "prayed_at_hokora",
        "action": { "type": "setFlag", "flag": "saw_city_ofuda", "message": "A tiny shrine wedged between two pipes. The ofuda is the same one as at the hokora on the rural street - freshly pasted." },
        "locked": { "type": "message", "text": "A tiny shrine wedged between two pipes, with a paper talisman. Someone keeps it clean." }
      }
    },
    {
      "name": "pachinko_doors",
      "interactable": {
        "prompt": "Enter the pachinko hall", "focus": [0.0, 1.5, 0.2], "radius": 3.0,
        "action": { "type": "message", "text": "The doors don't open for you. Behind the glass, a thousand steel balls roar." }
