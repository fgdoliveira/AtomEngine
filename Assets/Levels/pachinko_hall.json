{
  "$schema": "../Schemas/level.schema.json",
  "name": "pachinko_hall",
  "model": "Pachinko/pachinko.glb",
  "collision": "Pachinko/pachinko_col.glb",
  "lightmap": { "texture": "Pachinko/pachinko_lm.png", "intensity": 1.0 },
  "defaultSpawn": "entrance",
  "spawns": {
    "entrance": {}
  },
  "lighting": {
    "sunDirection": [0.0, 1.0, 0.0],
    "sunColor": [0.0, 0.0, 0.0],
    "skyColor": [0.30, 0.26, 0.26],
    "groundColor": [0.12, 0.06, 0.06],
    "fogColor": [0.06, 0.04, 0.05],
    "shadows": false,
    "glow": { "strength": 0.8, "threshold": 0.75 }
  },
  "outdoor": false,
  "screens": [
    { "material": "atom_pachinko_screen", "seed": 1 },
    { "material": "atom_pachinko_screen_b", "seed": 7 },
    { "material": "atom_pachinko_screen_play", "seed": 3 }
  ],
  "audio": {
    "beds": [
      { "sound": "pachinko_hall", "gain": 0.55 },
      { "sound": "drone", "gain": 0.05 }
    ],
    "reverb": { "mix": 0.3, "size": 1.6, "feedback": 0.6 }
  },
  "surfaces": { "default": "dirt" },
  "particles": { "leaves": false, "fogBanks": false },
  "unease": { "figure": false },
  "entities": [
    {
      "name": "exit_doors",
      "interactable": {
        "prompt": "Go back outside", "focus": [0.0, 1.3, 0.0], "radius": 2.6,
        "action": { "type": "changeLevel", "level": "night_street", "spawn": "from_pachinko" }
      }
    },
    {
      "name": "machine",
      "interactable": {
        "prompt": "Play", "focus": [-0.55, 1.4, 0.0], "radius": 2.2,
        "action": { "type": "playMachine", "screen": "atom_pachinko_screen_play", "machine": "Machines/night_fever.json",
                    "view": { "position": [-0.83, 1.4, -9.0], "yaw": -90, "pitch": 0 } }
      }
    },
    {
      "name": "prize_counter",
      "interactable": {
        "prompt": "Ask at the counter", "focus": [0.0, 1.1, -0.5], "radius": 2.6,
        "requires": "saw_city_ofuda",
        "action": { "type": "setFlag", "flag": "prize_ofuda", "message": "Behind the prizes, pinned to the shelf, the same ofuda. The attendant follows your eyes and says nothing." },
        "locked": { "type": "message", "text": "The attendant slides a tray of tokens toward you without looking up." }
      }
    }
  ]
}
