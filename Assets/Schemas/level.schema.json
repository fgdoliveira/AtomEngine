{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "atomengine/level.schema.json",
  "title": "AtomEngine level",
  "description": "A level: its models, spawns, light, sound and entities. The C++ parser (Game/Level/LevelData.cpp) is the authority; this schema gives editors completion and early warnings. Positions are in game space (metres, Y up); yaw in degrees (0 looks down -Z, 90 down +X). Spawn and entity positions may come from Blender markers (<level>.markers.json) instead.",
  "type": "object",
  "required": ["name", "model", "collision"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "description": "Must match the file name." },
    "model": { "type": "string", "description": "Scene glb, relative to Assets/." },
    "collision": { "type": "string", "description": "Collision glb, relative to Assets/." },
    "lightmap": {
      "type": "object",
      "description": "Baked light texture mapped by the model's second UV set (M16).",
      "required": ["texture"],
      "additionalProperties": false,
      "properties": {
        "texture": { "type": "string" },
        "intensity": { "type": "number", "minimum": 0, "default": 1 }
      }
    },
    "chunks": {
      "type": "array",
      "description": "Pieces drawn and culled as a whole (about one building or half a block), with their distance layer (M22).",
      "items": {
        "type": "object",
        "required": ["name", "model"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "model": { "type": "string", "description": "glb relative to Assets/." },
          "collision": { "type": "string", "description": "Optional collision glb, added to the level's." },
          "layer": { "enum": ["near", "mid", "far"], "default": "near" },
          "castsShadow": { "type": "boolean", "description": "Default: true for near, false for mid and far." },
          "cell": { "type": "string", "description": "Near chunks only: drawn when the player is in this cell or a neighbour." },
          "lightmap": { "type": "string", "description": "Baked light texture for this chunk's model (M25), relative to Assets/." }
        }
      }
    },
    "cells": {
      "type": "array",
      "description": "Connected rooms of the level; near chunks of far cells aren't drawn (M22).",
      "items": {
        "type": "object",
        "required": ["name", "min", "max"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "min": { "$ref": "#/definitions/vec3", "description": "Ground-plane bounds (x and z are used)." },
          "max": { "$ref": "#/definitions/vec3" },
          "neighbours": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "defaultSpawn": { "type": "string", "description": "Defaults to the first spawn by name." },
    "spawns": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "position": { "$ref": "#/definitions/vec3", "description": "Omit to take it from a spawn:<name> marker." },
          "yaw": { "type": "number" }
        }
      }
    },
    "lighting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sunDirection": { "$ref": "#/definitions/vec3" },
        "sunColor": { "$ref": "#/definitions/vec3" },
        "skyColor": { "$ref": "#/definitions/vec3" },
        "groundColor": { "$ref": "#/definitions/vec3" },
        "fogColor": { "$ref": "#/definitions/vec3" },
        "shadows": { "type": "boolean" },
        "bakedLight": { "type": "number", "minimum": 0, "maximum": 1, "description": "Weight of the vertex-colour bake (M15)." },
        "glow": {
          "type": "object",
          "description": "Bright parts blurred and added back (M23).",
          "additionalProperties": false,
          "properties": {
            "strength": { "type": "number", "minimum": 0, "default": 0.35 },
            "threshold": { "type": "number", "exclusiveMinimum": 0, "default": 1.0 }
          }
        }
      }
    },
    "sky": {
      "type": "object",
      "description": "Night sky panorama (equirectangular) behind everything (M23). Match fogColor to its horizon.",
      "required": ["panorama"],
      "additionalProperties": false,
      "properties": {
        "panorama": { "type": "string", "description": "Texture relative to Assets/." },
        "intensity": { "type": "number", "minimum": 0, "default": 1 }
      }
    },
    "impostors": {
      "type": "array",
      "description": "Pre-rendered buildings on camera-facing cards (M24).",
      "items": {
        "type": "object",
        "required": ["set", "position"],
        "additionalProperties": false,
        "properties": {
          "set": { "type": "string", "description": "Impostor descriptor (.json) relative to Assets/." },
          "position": { "$ref": "#/definitions/vec3", "description": "Centre of the building's footprint." },
          "yaw": { "type": "number" },
          "layer": { "enum": ["mid", "far"], "default": "far" }
        }
      }
    },
    "halos": {
      "type": "array",
      "description": "Soft additive glows around lights (M23).",
      "items": {
        "type": "object",
        "required": ["position"],
        "additionalProperties": false,
        "properties": {
          "position": { "$ref": "#/definitions/vec3" },
          "size": { "type": "number", "description": "Metres across." },
          "color": { "$ref": "#/definitions/vec3", "description": "Linear RGB." },
          "intensity": { "type": "number" },
          "flicker": { "type": "number", "minimum": 0, "maximum": 1 },
          "entity": { "type": "string", "description": "Rides on this entity (M25); position is then an offset from it." }
        }
      }
    },
    "screens": {
      "type": "array",
      "description": "Live screens (M27): scene materials of this name show a 320x240 render texture running a pachinko attract loop.",
      "items": {
        "type": "object",
        "required": ["material"],
        "additionalProperties": false,
        "properties": {
          "material": { "type": "string" },
          "seed": { "type": "integer", "minimum": 0, "description": "Different seeds play differently." },
          "machine": { "type": "string", "description": "A playfield (Assets/Machines) that plays itself on the screen (M32); without it, the simple attract loop." }
        }
      }
    },
    "lights": {
      "type": "array",
      "description": "Live point lights computed per pixel (M25): what moves or flickers. At most 4 are drawn.",
      "items": {
        "type": "object",
        "required": ["position", "radius"],
        "additionalProperties": false,
        "properties": {
          "position": { "$ref": "#/definitions/vec3" },
          "color": { "$ref": "#/definitions/vec3", "description": "Linear RGB." },
          "intensity": { "type": "number", "minimum": 0 },
          "radius": { "type": "number", "exclusiveMinimum": 0, "description": "Metres; no light past it." },
          "flicker": { "type": "number", "minimum": 0, "maximum": 1, "description": "Stutters like a halo at the same position." },
          "entity": { "type": "string", "description": "Rides on this entity; position is then an offset from it." },
          "material": { "type": "string", "description": "A scene material whose emission stutters along." }
        }
      }
    },
    "outdoor": { "type": "boolean", "default": true },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "beds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["sound"],
            "additionalProperties": false,
            "properties": {
              "sound": { "$ref": "#/definitions/sound" },
              "gain": { "type": "number" }
            }
          }
        },
        "emitters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["sound", "position"],
            "additionalProperties": false,
            "properties": {
              "sound": { "$ref": "#/definitions/sound" },
              "group": { "type": "string" },
              "position": { "$ref": "#/definitions/vec3" },
              "gain": { "type": "number" },
              "minDistance": { "type": "number" },
              "maxDistance": { "type": "number" }
            }
          }
        },
        "zones": {
          "type": "array",
          "description": "Ambience per cell (M25): beds fade in while the player is in the cell.",
          "items": {
            "type": "object",
            "required": ["cell", "beds"],
            "additionalProperties": false,
            "properties": {
              "cell": { "type": "string" },
              "beds": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["sound"],
                  "additionalProperties": false,
                  "properties": {
                    "sound": { "$ref": "#/definitions/sound" },
                    "gain": { "type": "number" }
                  }
                }
              }
            }
          }
        },
        "zoneFadeSeconds": { "type": "number", "minimum": 0, "default": 2 },
        "reverb": {
          "type": "object",
          "description": "Room reverb on the whole mix while in the level (M27).",
          "additionalProperties": false,
          "properties": {
            "mix": { "type": "number", "minimum": 0, "maximum": 1 },
            "size": { "type": "number", "exclusiveMinimum": 0, "description": "Scales the echo delays: 1 is a small hall." },
            "feedback": { "type": "number", "minimum": 0, "exclusiveMaximum": 1, "description": "How long the tail rings." }
          }
        }
      }
    },
    "surfaces": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": { "$ref": "#/definitions/surface" },
        "zones": {
          "type": "array",
          "description": "Rectangles on the ground (x and z of min/max); the first match wins.",
          "items": {
            "type": "object",
            "required": ["min", "max", "surface"],
            "additionalProperties": false,
            "properties": {
              "min": { "$ref": "#/definitions/vec3" },
              "max": { "$ref": "#/definitions/vec3" },
              "surface": { "$ref": "#/definitions/surface" }
            }
          }
        }
      }
    },
    "particles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "leaves": { "type": "boolean" },
        "fogBanks": { "type": "boolean" }
      }
    },
    "lab": {
      "type": "object",
      "description": "Character lab (M36): the level opens in the model viewer, orbiting the subject entity.",
      "additionalProperties": false,
      "required": ["subject"],
      "properties": {
        "subject": { "type": "string", "description": "Entity with a skinned model." },
        "target": { "$ref": "#/definitions/vec3", "description": "Orbit centre, relative to the subject." },
        "distance": { "type": "number", "exclusiveMinimum": 0 },
        "yaw": { "type": "number" },
        "pitch": { "type": "number" }
      }
    },
    "unease": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "figure": { "type": "boolean" },
        "figureSpots": { "type": "array", "items": { "$ref": "#/definitions/vec3" } },
        "flickerMaterial": { "type": "string" },
        "flickerSites": { "type": "array", "items": { "$ref": "#/definitions/vec3" } }
      }
    },
    "entities": {
      "type": "array",
      "items": { "$ref": "#/definitions/entity" }
    },
    "sequences": {
      "type": "object",
      "description": "Named timed step lists (M26), started by a \"sequence\" action; the player is frozen while one runs.",
      "additionalProperties": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/step" } }
    }
  },
  "definitions": {
    "vec3": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    },
    "surface": { "enum": ["asphalt", "concrete", "dirt", "stone", "wood"] },
    "sound": {
      "type": "string",
      "description": "A sound from the library (Game/AudioScape.cpp).",
      "enum": ["wind", "cicadas", "drone", "vending_hum", "static", "room_tone", "creak",
               "traffic", "neon_buzz", "voices", "street_bells", "pachinko_leak", "train", "bus_engine", "door_hiss", "pachinko_hall"]
    },
    "entity": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "description": "Unique in the level; scripts and markers use it." },
        "position": { "$ref": "#/definitions/vec3", "description": "Omit to take it from an entity:<name> marker." },
        "yaw": { "type": "number" },
        "scale": { "type": "number", "exclusiveMinimum": 0, "description": "Uniform scale of the model (M35)." },
        "model": { "type": "string", "description": "glb relative to Assets/." },
        "hidden": { "type": "boolean", "description": "Not drawn until a sequence shows it (M26)." },
        "goneWithFlag": { "type": "string", "description": "Hidden and unusable for good once this flag is set: something taken (M44)." },
        "collider": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "center": { "$ref": "#/definitions/vec3" },
            "halfExtents": { "$ref": "#/definitions/vec3" }
          }
        },
        "interactable": {
          "type": "object",
          "required": ["action"],
          "additionalProperties": false,
          "properties": {
            "prompt": { "type": "string", "description": "Shown as [E] <prompt>." },
            "focus": { "$ref": "#/definitions/vec3" },
            "radius": { "type": "number" },
            "requires": { "type": "string", "description": "Flag needed; otherwise \"locked\" runs." },
            "requiresLight": { "type": "boolean", "description": "Only found while the flashlight lights its focus point (M44)." },
            "action": { "$ref": "#/definitions/action" },
            "locked": { "$ref": "#/definitions/action" }
          }
        },
        "animator": {
          "type": "object",
          "description": "Animation state machine (M37): states (a clip, or two clips blended by a parameter) and transitions on parameter conditions.",
          "required": ["initial", "states"],
          "additionalProperties": false,
          "properties": {
            "initial": { "type": "string" },
            "states": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "clip": { "type": "string" },
                  "blend": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2 },
                  "param": { "type": "string" },
                  "range": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
                  "loop": { "type": "boolean" },
                  "next": { "type": "string", "description": "One-shot: the state it returns to." },
                  "inPlace": { "type": "string", "description": "A joint held at its rest position: the clip's own travel removed (M38)." },
                  "nextBlend": { "type": "number" }
                }
              }
            },
            "events": {
              "type": "object",
              "description": "Per clip, per event name, the seconds into the clip it happens at (M38: \"foot\" plays a footstep).",
              "additionalProperties": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "number" } } }
            },
            "transitions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["from", "to"],
                "additionalProperties": false,
                "properties": {
                  "from": { "type": "string", "description": "A state, or * for any." },
                  "to": { "type": "string" },
                  "when": { "type": "array", "items": { "type": "string", "pattern": "^\\s*\\w+\\s+(<|<=|>|>=|==|!=)\\s+-?[0-9.]+\\s*$" } },
                  "blend": { "type": "number", "minimum": 0 }
                }
              }
            }
          }
        },
        "animation": {
          "type": "object",
          "required": ["clip"],
          "additionalProperties": false,
          "properties": {
            "clip": { "type": "string" },
            "loop": { "type": "boolean", "default": true },
            "autoplay": { "type": "boolean", "default": true },
            "speed": { "type": "number" },
            "sound": { "$ref": "#/definitions/sound" },
            "soundsPerLoop": { "type": "integer", "minimum": 1 },
            "soundOffset": { "$ref": "#/definitions/vec3" }
          }
        },
        "mover": {
          "type": "object",
          "description": "Shuttles the entity to position + travel and back (M25), e.g. a train.",
          "required": ["travel", "travelSeconds"],
          "additionalProperties": false,
          "properties": {
            "travel": { "$ref": "#/definitions/vec3" },
            "travelSeconds": { "type": "number", "exclusiveMinimum": 0 },
            "waitSeconds": { "type": "number", "minimum": 0 },
            "startSeconds": { "type": "number" },
            "sound": { "$ref": "#/definitions/sound", "description": "Loops, follows the entity, heard while it moves." },
            "gain": { "type": "number" },
            "minDistance": { "type": "number" },
            "maxDistance": { "type": "number" }
          }
        }
      }
    },
    "action": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["message", "setFlag", "dialogue", "changeLevel", "playAnimation", "sequence", "playMachine", "addCounter", "exchange"] }
      },
      "oneOf": [
        {
          "properties": { "type": { "const": "message" }, "text": { "type": "string" } },
          "required": ["text"], "additionalProperties": false
        },
        {
          "properties": { "type": { "const": "setFlag" }, "flag": { "type": "string" }, "message": { "type": "string" } },
          "required": ["flag"], "additionalProperties": false
        },
        {
          "properties": { "type": { "const": "dialogue" }, "id": { "type": "string" } },
          "required": ["id"], "additionalProperties": false
        },
        {
          "properties": { "type": { "const": "changeLevel" }, "level": { "type": "string" }, "spawn": { "type": "string" } },
          "required": ["level"], "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "playAnimation" }, "entity": { "type": "string" },
            "clip": { "type": "string" }, "message": { "type": "string" }
          },
          "required": ["entity", "clip"], "additionalProperties": false
        },
        {
          "properties": { "type": { "const": "sequence" }, "id": { "type": "string", "description": "One of the level's sequences (M26)." } },
          "required": ["id"], "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "playMachine" },
            "screen": { "type": "string", "description": "The machine's screen material; the game takes it over (M29)." },
            "machine": { "type": "string", "description": "The playfield file, relative to Assets/ (M31)." },
            "view": {
              "type": "object",
              "description": "Where the camera goes: in front of the screen.",
              "required": ["position"],
              "additionalProperties": false,
              "properties": { "position": { "$ref": "#/definitions/vec3" }, "yaw": { "type": "number" }, "pitch": { "type": "number" } }
            }
          },
          "required": ["screen", "machine", "view"], "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "addCounter" },
            "counter": { "type": "string", "description": "A GameState counter, e.g. tokens (M33)." },
            "amount": { "type": "integer" },
            "message": { "type": "string" },
            "once": { "type": "string", "description": "A flag set the first time; after that, \"again\" is shown instead." },
            "again": { "type": "string" }
          },
          "required": ["counter", "amount"], "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "exchange" },
            "counter": { "type": "string", "description": "What is spent, e.g. balls (M33)." },
            "cost": { "type": "integer", "minimum": 1 },
            "flag": { "type": "string", "description": "What you get." },
            "message": { "type": "string" },
            "short": { "type": "string", "description": "Shown when there isn't enough." }
          },
          "required": ["counter", "cost", "flag"], "additionalProperties": false
        }
      ]
    },
    "step": {
      "type": "object",
      "description": "One step of a sequence (M26).",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["wait", "message", "setFlag", "show", "hide", "playSound", "playAnimation", "moveEntity", "changeLevel"] },
        "seconds": { "type": "number", "exclusiveMinimum": 0, "description": "wait, moveEntity." },
        "text": { "type": "string", "description": "message." },
        "flag": { "type": "string", "description": "setFlag." },
        "entity": { "type": "string", "description": "show, hide, playSound (follows it), playAnimation, moveEntity." },
        "sound": { "$ref": "#/definitions/sound" },
        "gain": { "type": "number" },
        "loop": { "type": "boolean", "description": "playSound: loops until the level unloads." },
        "clip": { "type": "string" },
        "to": { "$ref": "#/definitions/vec3", "description": "moveEntity: where it stops (eases out)." },
        "level": { "type": "string", "description": "changeLevel: always the last step." },
        "spawn": { "type": "string" }
      }
    }
  }
}
