{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AtomEngine environment preset (M49)",
  "description": "Weather or time of day: Assets/Environments/<name>.json. The same keys as a level's lighting environment, all optional; what a preset leaves out comes from the level. Tune live in the developer tools (F10, Environment) and paste Copy as JSON here.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "description": "For people; the file name is what levels use." },
    "sunDirection": { "$ref": "#/definitions/vec3", "description": "Towards the sun (or the moon)." },
    "sunColor": { "$ref": "#/definitions/vec3" },
    "skyColor": { "$ref": "#/definitions/vec3", "description": "Ambient light from above." },
    "groundColor": { "$ref": "#/definitions/vec3", "description": "Ambient light bounced from below." },
    "fogColor": { "$ref": "#/definitions/vec3" },
    "fogDensity": { "type": "number", "minimum": 0, "description": "Used while the player's fog setting is \"level\"." },
    "skyGradient": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "zenith": { "$ref": "#/definitions/vec3" },
        "horizon": { "$ref": "#/definitions/vec3" },
        "sunSize": { "type": "number", "minimum": 0, "maximum": 20 },
        "sunGlow": { "type": "number", "minimum": 0 }
      }
    },
    "rain": { "type": "number", "minimum": 0, "maximum": 1, "default": 0, "description": "Rain (M50): 0 dry .. 1 downpour; outdoors only." },
    "wind": { "$ref": "#/definitions/vec3", "description": "Wind (M50), m/s: sway, leaves, the rain's slant." },
    "water": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shallow": { "$ref": "#/definitions/vec3" },
        "deep": { "$ref": "#/definitions/vec3" },
        "skyReflection": { "type": "number", "minimum": 0, "maximum": 1 },
        "ripple": { "type": "number", "minimum": 0 },
        "glint": { "type": "number", "minimum": 0, "default": 1.0, "description": "The sun's highlight on the water." },
        "reflection": { "type": "boolean", "default": false, "description": "Mirror the near scene in the water (M51): a half-resolution render pass, ~0.2 ms." }
      }
    }
  },
  "definitions": {
    "vec3": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }
  }
}
