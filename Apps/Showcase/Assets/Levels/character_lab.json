{
  "$schema": "../../../../Framework/Schemas/level.schema.json",
  "name": "character_lab",
  "model": "Lab/lab.glb",
  "collision": "Lab/lab_col.glb",
  "defaultSpawn": "start",
  "spawns": {
    "start": {}
  },
  "lighting": {
    "sunDirection": [-0.45, 0.75, 0.5],
    "sunColor": [1.0, 0.96, 0.9],
    "skyColor": [0.62, 0.68, 0.78],
    "groundColor": [0.34, 0.33, 0.36],
    "fogColor": [0.74, 0.78, 0.85],
    "shadows": true,
    "bakedLight": 1.0,
    "glow": { "strength": 0.0, "threshold": 1.0 }
  },
  "outdoor": false,
  "audio": {
    "beds": []
  },
  "surfaces": { "default": "concrete" },
  "particles": { "leaves": false, "fogBanks": false },
  "unease": { "figure": false },
  "lab": {
    "subject": "rudy",
    "target": [0.0, 0.85, 0.0],
    "distance": 3.6,
    "yaw": 20.0,
    "pitch": 10.0
  },
  "entities": [
    {
      "name": "rudy",
      "model": "ThirdParty/rudy.glb",
      "scale": 0.8,
      "animator": {
        "initial": "idle",
        "states": {
          "idle": { "clip": "Idle" },
          "move": { "blend": ["Walk", "Run"], "param": "speed", "range": [1.4, 4.0] },
          "jump": { "clip": "Jump", "loop": false, "next": "idle", "nextBlend": 0.2, "inPlace": "hips" }
        },
        "transitions": [
          { "from": "*", "to": "jump", "when": ["grounded == 0"], "blend": 0.1 },
          { "from": "jump", "to": "move", "when": ["grounded == 1", "speed > 0.2"], "blend": 0.15 },
          { "from": "jump", "to": "idle", "when": ["grounded == 1"], "blend": 0.2 },
          { "from": "idle", "to": "move", "when": ["speed > 0.2"], "blend": 0.25 },
          { "from": "move", "to": "idle", "when": ["speed <= 0.2"], "blend": 0.3 }
        ],
        "events": {
          "Walk": { "foot": [0.45, 0.98] },
          "Run": { "foot": [0.33, 0.66] }
        }
      }
    }
  ]
}
