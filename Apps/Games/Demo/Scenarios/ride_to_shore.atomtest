# The Kawasaki: street -> coast road -> shore and back. Every ride steers;
# reaching the shore sets rode_to_shore. Holding a key moves the bike
# across the road. Jumps along the road (set ride_progress) so the run
# doesn't take two minutes.
# Run: ATOM_TEST_SCRIPT=Apps/Games/Demo/Scenarios/ride_to_shore.atomtest Demo

expect_level street
teleport_to kawasaki
expect_target kawasaki
interact kawasaki
wait 2.5
expect_level coast_road
expect_mode riding
expect_stat ride_steer == 1
expect_no_flag rode_to_shore

# Under way, and steered: holding right takes it across the road.
wait 2
expect_stat ride_progress > 0.005
hold_action move_right on
wait 1.5
hold_action move_right off
expect_stat ride_offset > 1.5

# F switches the headlight, and back.
expect_stat ride_headlight == 1
press_action toggle_light
wait 0.2
expect_stat ride_headlight == 0
press_action toggle_light
wait 0.2
expect_stat ride_headlight == 1
set ride_progress 0.995
wait 4

# The shore: on foot, the flag set.
expect_level shore
expect_mode exploring
expect_flag rode_to_shore
teleport_to kawasaki
expect_target kawasaki
interact kawasaki
wait 3

# The road back, the other way.
expect_level coast_road
expect_mode riding
expect_stat ride_steer == 1
set ride_progress 0.995
wait 4
expect_level street
expect_mode exploring
log ride_to_shore done
